[Desktop Entry]
Type=Application
Name=MP Mix Archive Manager
GenericName=Music Archive Manager
Comment=Launch MP Mix Archive Manager in Konsole
# The install tree is resolved at launch, so no versioned path is stored here.
Exec=sh -c "exec \\"\\$HOME/.local/bin/mp-desktop-exec\\" bin/launch-manager"
Icon=utilities-terminal
Terminal=false
Categories=AudioVideo;Audio;Utility;
StartupNotify=true
X-KDE-GlobalAccel-CommandShortcut=true
