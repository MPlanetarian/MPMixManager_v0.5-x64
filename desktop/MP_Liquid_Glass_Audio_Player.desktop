[Desktop Entry]
Type=Application
Name=MP Liquid Player
GenericName=Liquid Transparent Audio Player
Comment=Launch MP Audio Player in Liquid Transparent Glass Mode
# The install tree is resolved at launch, so no user name or versioned path is
# stored here. mp-desktop-exec lives in ~/.local/bin and follows the install.
Exec=sh -c "exec \\"\\$HOME/.local/bin/mp-desktop-exec\\" launch_liquid_glass.sh"
Icon=mp_liquid_glass_icon
Terminal=false
Categories=AudioVideo;Audio;Player;
StartupNotify=true
X-KDE-GlobalAccel-CommandShortcut=true
