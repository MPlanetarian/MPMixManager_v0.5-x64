# Stray scratch files from local test/generation runs.
# Seen in the repo root as bare numeric filenames (81, 143, 268, ...) plus an
# "info" file, each 7 bytes containing the literal text "PNGDATA" rather than
# real image data. Origin is unconfirmed, so these are anchored to the root to
# avoid hiding a legitimate numeric asset in a subdirectory.
/[0-9][0-9]
/[0-9][0-9][0-9]
/info

# Editor backup copies (the existing *.bak* rule does not match *.bk)
*.bk

# --- 0.5.1 security and hygiene -------------------------------------------
# A committed WebUI secret and SMB password were found in the 0.5.0 tree.
# These rules keep either from coming back.
MIX_ARCHIVE/
*.webui_secret_key
*secret_key*
*.token
companion.token

# Generated test/run evidence must never ship. Each subdirectory of REPORTS is
# a dated capture; the .gitkeep files are re-included below.
REPORTS/*/
!REPORTS/DAILY_REPORTS/
!REPORTS/WEEKLY_REPORTS/
!REPORTS/MONTHLY_REPORTS/
!REPORTS/YEARLY_REPORTS/

# MP Auto Tester output: per-host trees pushed to test machines, and the
# screenshot archive when a run is pointed inside the checkout (the default is
# ~/MP_TESTER_MIX_MANAGER_SCREENSHOTS, outside the tree).
MP_AUTO_TESTER_TREE/
deploy-*.tar.gz
MP_TESTER_MIX_MANAGER_SCREENSHOTS/

# MP Auto Responder is a separate program. It is not part of MP Mix Manager
# and must not be published with this repository.
scripts/manage_mp_responder.sh
MP_OpenCode_Audio_Responder.sh
MP_AI_Agent_Audio_Responder*/
tests/test_opencode_audio_responder_loop.py
tests/test_responder_hourly_update.py
tests/test_responder_other_agents.py
tests/test_responder_session_progress.py
test-evidence/

# MP_Auto_Tester_Flash.sh is an INTERNAL DREAMWORLDS PRODUCTIONS DEV UTILITY.
# It is deliberately not published: it contains this studio's private test-bed
# topology (LAN addresses for the Mac mini / Fedora workstation, the Windows 11
# and FreeBSD VM paths and VNC endpoints, and the SMB/VM credentials used to
# drive them). Those are internal infrastructure details, not something a user
# of MP Mix Manager should receive. Keep the file in the working tree; never
# commit it.
#
# The report builder, the MP Reporter bridge and the Windows agent stay tracked
# because they are shipped and user-facing; only the controller is internal.
/MP_Auto_Tester_Flash.sh

# MP Visualisation Generator is an INTERNAL DREAMWORLDS PRODUCTIONS DEV TOOL.
# It builds private 3D presets from artwork and is not part of the public
# MP Mix Manager distribution. Keep the files in the working tree; never
# commit them. The visualizer backends load user presets optionally, so a
# checkout without these files still runs normally.
/MP_Visualization_Generator.py
/MP_Visualization_Generator.sh
/MP_Visualization_Generator.desktop
/scripts/mp_visualizer_user_presets.py

# Generated visualizer preset packages and any repo-local preset cache.
*.mpvispreset
/shaders/user_presets/

# Scratch files that were tracked by accident. Named explicitly because the
# numeric-only rules above missed them (all four are 7 bytes of "PNGDATA").
/status
/clients
/sinks
/sink-inputs
/$state_file
/Grey
/.conout.txt
/.dbg.txt
/.probe.sh
/.probe_mgr.sh
/MP_Error.log

# Render/verification scratch: screenshots and throwaway probe scripts written
# while testing a visual change. They are never shipped and would only add
# stale duplicate images to the tree.
/.tmp_preview/
/scripts/_probe_*.ps1

# Large sample media belongs in Git LFS or a release asset, not a blob.
#
# The exception below is deliberate and load-bearing: the bundled sample track is
# committed (and already on GitHub), and tests/test_first_run_sample_track.py
# asserts it is present and over 50 MB. Ignoring new media files while keeping
# this one tracked matches what the repo actually needs, and a fresh clone's
# tests keep passing. Moving it to LFS or a release asset is a separate change
# that has to rewrite history.
#
# The bundled track ships as a 16-bit FLAC (63.5 MB). The 24-bit WAV master is
# 242 MB and GitHub rejects any single file over 100 MB, so the WAV is never
# committed: it is the mastering source, not a release artifact.
MP_SAMPLES/*.wav
MP_SAMPLES/*.flac
!MP_SAMPLES/MPlanetarian - The Orbits of Planets (Cosmic Dreamworlds Remake).flac

# Review packets are sign-off artifacts for a single piece of work, not shipped
# documentation. They embed a full copy of a branch's diff, so committing one
# publishes a stale duplicate of code that already lives in the tree. Keep the
# file beside the checkout; it is never a release artifact.
/PI_REVIEW_PACKET.md

# Windows MSI build scratch (never shipped)
.build_tmp/
*.wixpdb
