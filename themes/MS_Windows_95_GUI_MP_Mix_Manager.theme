#MS Windows 95 GUI MP Mix Manager
#MS Windows 95 GUI (Nostalgia Theme)
#MPlanetarian Nostalgia Collection
#The classic Desktop Window Manager defaults: the silver Window face (#c0c0c0)
#as the pane, black WindowText ink, the navy Active Title Bar, the teal desktop
#and the grey 3D bevels. Every other colour is a Win95 system colour.

# Main background (Window / ButtonFace silver)
theme[main_bg]="#c0c0c0"

# Main text color (WindowText black)
theme[main_fg]="#000000"

# Title color for boxes (Active Title Bar navy)
theme[title]="#000080"

# Highlight color for keyboard shortcuts (Highlight navy)
theme[hi_fg]="#000080"

# Background color of selected item in processes box (Highlight navy)
theme[selected_bg]="#000080"

# Foreground color of selected item in processes box (HighlightText white)
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text (GrayText)
theme[inactive_fg]="#808080"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#000000"

# Background color of the percentage meters (Button Shadow grey)
theme[meter_bg]="#808080"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#000080"

# Cpu box outline color (Button Shadow grey)
theme[cpu_box]="#808080"

# Memory/disks box outline color (Button Shadow grey)
theme[mem_box]="#808080"

# Net up/down box outline color (Button Shadow grey)
theme[net_box]="#808080"

# Processes box outline color (Button Shadow grey)
theme[proc_box]="#808080"

# Box divider line and small boxes line color (Button Dark Shadow)
theme[div_line]="#404040"

# Temperature graph colors (Teal -> Olive -> Maroon)
theme[temp_start]="#008080"
theme[temp_mid]="#808000"
theme[temp_end]="#800000"

# CPU graph colors (Navy -> Teal -> Silver)
theme[cpu_start]="#000080"
theme[cpu_mid]="#008080"
theme[cpu_end]="#c0c0c0"

# Mem/Disk free meter
theme[free_end]="#008080"
theme[free_mid]="#008000"
theme[free_start]="#000080"

# Mem/Disk cached meter
theme[cached_start]="#808080"
theme[cached_mid]="#008080"
theme[cached_end]="#000080"

# Mem/Disk available meter
theme[available_start]="#800000"
theme[available_mid]="#808000"
theme[available_end]="#008080"

# Mem/Disk used meter
theme[used_start]="#000080"
theme[used_mid]="#008080"
theme[used_end]="#800000"

# Download graph colors
theme[download_start]="#000080"
theme[download_mid]="#008080"
theme[download_end]="#008000"

# Upload graph colors
theme[upload_start]="#800000"
theme[upload_mid]="#808000"
theme[upload_end]="#008080"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#000080"
theme[process_mid]="#008080"
theme[process_end]="#808080"
