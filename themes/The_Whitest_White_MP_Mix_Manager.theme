#The Whitest White MP Mix Manager
#MPlanetarian The Whitest White
#A single white pane with black text. Every control, meter, graph and box is
#white, and every glyph is black, so btop matches the manager exactly.

# Main background
theme[main_bg]="#ffffff"

# Main text color
theme[main_fg]="#000000"

# Title color for boxes
theme[title]="#000000"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#000000"

# Background color of selected item in processes box
theme[selected_bg]="#ffffff"

# Foreground color of selected item in processes box
theme[selected_fg]="#000000"

# Color of inactive/disabled text
theme[inactive_fg]="#000000"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#000000"

# Background color of the percentage meters
theme[meter_bg]="#ffffff"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#000000"

# Cpu box outline color
theme[cpu_box]="#000000"

# Memory/disks box outline color
theme[mem_box]="#000000"

# Net up/down box outline color
theme[net_box]="#000000"

# Processes box outline color
theme[proc_box]="#000000"

# Box divider line and small boxes line color
theme[div_line]="#000000"

# Temperature graph colors
theme[temp_start]="#000000"
theme[temp_mid]="#000000"
theme[temp_end]="#000000"

# CPU graph colors
theme[cpu_start]="#000000"
theme[cpu_mid]="#000000"
theme[cpu_end]="#000000"

# Mem/Disk free meter
theme[free_end]="#000000"
theme[free_mid]="#000000"
theme[free_start]="#000000"

# Mem/Disk cached meter
theme[cached_start]="#000000"
theme[cached_mid]="#000000"
theme[cached_end]="#000000"

# Mem/Disk available meter
theme[available_start]="#000000"
theme[available_mid]="#000000"
theme[available_end]="#000000"

# Mem/Disk used meter
theme[used_start]="#000000"
theme[used_mid]="#000000"
theme[used_end]="#000000"

# Download graph colors
theme[download_start]="#000000"
theme[download_mid]="#000000"
theme[download_end]="#000000"

# Upload graph colors
theme[upload_start]="#000000"
theme[upload_mid]="#000000"
theme[upload_end]="#000000"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#000000"
theme[process_mid]="#000000"
theme[process_end]="#000000"
