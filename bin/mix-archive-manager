#!/usr/bin/env bash
# ==============================================================================
# Helper: mix-archive-manager
# Purpose: Launch MP Mix Archive Manager cleanly from codebase or archive directory
# ==============================================================================
# Resolve symlinks so CODEBASE_DIR is accurate regardless of invocation path (e.g. ~/.local/bin)
_RESOLVED_SRC="${BASH_SOURCE[0]}"
while [ -h "$_RESOLVED_SRC" ]; do
    _RESOLVED_DIR="$(cd -P "$(dirname "$_RESOLVED_SRC")" >/dev/null 2>&1 && pwd)"
    _RESOLVED_SRC="$(readlink "$_RESOLVED_SRC")"
    [[ $_RESOLVED_SRC != /* ]] && _RESOLVED_SRC="$_RESOLVED_DIR/$_RESOLVED_SRC"
done
_BIN_DIR="$(cd -P "$(dirname "$_RESOLVED_SRC")" >/dev/null 2>&1 && pwd)"
CODEBASE_DIR="$(cd -P "$_BIN_DIR/.." >/dev/null 2>&1 && pwd)"

# Fallback candidate search if not found. Resolve by marker file rather than a
# hard-coded user name or version-numbered directory.
if [ ! -f "$CODEBASE_DIR/Mix_Archive_Manager.sh" ]; then
    _lib="$CODEBASE_DIR/scripts/lib/mp_install_dir.sh"
    [ ! -f "$_lib" ] && _lib="$HOME/.config/mix-manager/lib/mp_install_dir.sh"
    [ -f "$_lib" ] && . "$_lib"
    _found=""
    if command -v mp_find_install_dir >/dev/null 2>&1; then
        _found="$(mp_find_install_dir 2>/dev/null || true)"
    fi
    if [ -z "$_found" ]; then
        for _c in $(ls -d "$HOME"/MP*ix*anager* 2>/dev/null | sort -rV); do
            if [ -f "$_c/Mix_Archive_Manager.sh" ]; then
                _found="$_c"
                break
            fi
        done
    fi
    [ -n "$_found" ] && CODEBASE_DIR="$_found"
fi
unset _RESOLVED_SRC _RESOLVED_DIR _BIN_DIR _c _found _lib

# Load configuration if available
if [ -f "$CODEBASE_DIR/config.env" ]; then
    # shellcheck source=/dev/null
    source "$CODEBASE_DIR/config.env"
fi

# Where to start the console. Archive storage is optional: the MIX_ARCHIVE drive
# (and any MUSIC_FOLDERS share) may be offline, and that must never keep the
# user out of the manager. An unavailable MIX_ARCHIVE_DIR falls back to the
# application tree, where the manager can still open, play local mixes, and let
# the user mount/configure storage from its own menus.
_ARCHIVE_DIR="${MIX_ARCHIVE_DIR:-}"
case "$_ARCHIVE_DIR" in
    "") ;;
    /*|[A-Za-z]:[\\/]*) ;;
    *) _ARCHIVE_DIR="$CODEBASE_DIR/${_ARCHIVE_DIR#./}" ;;
esac
SCRIPT="$CODEBASE_DIR/Mix_Archive_Manager.sh"

# Fast-path CLI commands that don't need archive storage mounted
if [ "${1:-}" = "update" ] || [ "${1:-}" = "--update" ]; then
    shift
    if [ -x "$CODEBASE_DIR/scripts/update_manager.sh" ]; then
        exec bash "$CODEBASE_DIR/scripts/update_manager.sh" "$@"
    elif [ -x "$CODEBASE_DIR/update_manager.sh" ]; then
        exec bash "$CODEBASE_DIR/update_manager.sh" "$@"
    fi
elif [ "${1:-}" = "version" ] || [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
    shift
    if [ -x "$CODEBASE_DIR/scripts/update_manager.sh" ]; then
        exec bash "$CODEBASE_DIR/scripts/update_manager.sh" --version "$@"
    elif [ -x "$CODEBASE_DIR/update_manager.sh" ]; then
        exec bash "$CODEBASE_DIR/update_manager.sh" --version "$@"
    fi
elif [ "${1:-}" = "help" ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    shift
    if [ -x "$CODEBASE_DIR/scripts/show_help.sh" ]; then
        exec bash "$CODEBASE_DIR/scripts/show_help.sh" "$@"
    elif [ -x "$CODEBASE_DIR/show_help.sh" ]; then
        exec bash "$CODEBASE_DIR/show_help.sh" "$@"
    fi
elif [ "${1:-}" = "reinstall" ] || [ "${1:-}" = "--reinstall" ] || [ "${1:-}" = "factory-reset" ] || [ "${1:-}" = "--factory-reset" ]; then
    shift
    if [ -f "$CODEBASE_DIR/scripts/reinstall_mp_manager.sh" ]; then
        exec bash "$CODEBASE_DIR/scripts/reinstall_mp_manager.sh" --root "$CODEBASE_DIR" "$@"
    elif [ -f "$CODEBASE_DIR/install.sh" ]; then
        exec bash "$CODEBASE_DIR/install.sh" --reinstall "$@"
    fi
    echo "Error: the reinstall helper was not found." >&2
    exit 1
elif [ "${1:-}" = "alarm" ] || [ "${1:-}" = "--alarm" ] || [ "${1:-}" = "alarm-clock" ] || [ "${1:-}" = "--alarm-clock" ]; then
    shift
    if [ -x "$CODEBASE_DIR/mplanetarians-alarm-clock/alarm.sh" ]; then
        exec bash "$CODEBASE_DIR/mplanetarians-alarm-clock/alarm.sh" "$@"
    elif [ -x "$CODEBASE_DIR/alarm.sh" ]; then
        exec bash "$CODEBASE_DIR/alarm.sh" "$@"
    fi
elif [ "${1:-}" = "congen" ] || [ "${1:-}" = "--congen" ] || [ "${1:-}" = "kdeconnect" ] || [ "${1:-}" = "--kdeconnect" ]; then
    shift
    if [ -x "$CODEBASE_DIR/Congen/Congen" ]; then
        exec bash "$CODEBASE_DIR/Congen/Congen" "$@"
    elif [ -x "$CODEBASE_DIR/congen" ]; then
        exec bash "$CODEBASE_DIR/congen" "$@"
    fi
elif [ "${1:-}" = "top5" ] || [ "${1:-}" = "--top5" ] || [ "${1:-}" = "top-5" ] || [ "${1:-}" = "--top-5" ]; then
    shift
    if [ -x "$CODEBASE_DIR/scripts/manage_top_5_tracks.sh" ]; then
        exec bash "$CODEBASE_DIR/scripts/manage_top_5_tracks.sh" "$@"
    elif [ -f "$CODEBASE_DIR/scripts/top_5_tracks_manager.py" ]; then
        exec python3 "$CODEBASE_DIR/scripts/top_5_tracks_manager.py" "$@"
    fi
elif [ "${1:-}" = "visualizer" ] || [ "${1:-}" = "--visualizer" ] || [ "${1:-}" = "vis" ] || [ "${1:-}" = "--vis" ] || [ "${1:-}" = "mp-visualizer" ] || [ "${1:-}" = "--mp-visualizer" ]; then
    shift
    if [ -f "$CODEBASE_DIR/MP_Liquid_Visualizer.py" ]; then
        exec python3 "$CODEBASE_DIR/MP_Liquid_Visualizer.py" "$@"
    elif [ -f "$CODEBASE_DIR/scripts/mp_liquid_visualizer_vulkan.py" ]; then
        exec python3 "$CODEBASE_DIR/scripts/mp_liquid_visualizer_vulkan.py" "$@"
    fi
elif [ "${1:-}" = "block-internet" ] || [ "${1:-}" = "--block-internet" ]; then
    shift
    if command -v systemd-run >/dev/null 2>&1; then
        exec systemd-run --user --pipe block-internet "$@"
    else
        exec sudo block-internet "$@"
    fi
elif [ "${1:-}" = "unblock-internet" ] || [ "${1:-}" = "--unblock-internet" ]; then
    shift
    if command -v systemd-run >/dev/null 2>&1; then
        exec systemd-run --user --pipe unblock-internet "$@"
    else
        exec sudo unblock-internet "$@"
    fi
fi


# Give a drive that is still settling at login a short, bounded grace period.
# This wait is never fatal and can be skipped with MP_ARCHIVE_MOUNT_WAIT=0: if
# the archive (or a MUSIC_FOLDERS share) is simply not mounted, the manager
# still opens from the application tree.
if [ -n "$_ARCHIVE_DIR" ] && [ ! -d "$_ARCHIVE_DIR" ]; then
    _is_offline=0
    case "$_ARCHIVE_DIR" in
        *GoogleDrive*|*google-drive*|*rclone*|*Dropbox*|*iCloud*|*OneDrive*|*Nextcloud*)
            if ! timeout 0.8 bash -c 'cat < /dev/null > /dev/tcp/1.1.1.1/53' 2>/dev/null; then
                _is_offline=1
            fi
            ;;
    esac
    if [ "$_is_offline" -eq 1 ]; then
        echo "Notice: Configured archive storage is cloud-hosted and internet is offline. Proceeding with local storage..."
    else
        _mount_wait="${MP_ARCHIVE_MOUNT_WAIT:-2}"
        if [[ "$_mount_wait" =~ ^[0-9]+$ ]] && [ "$_mount_wait" -gt 0 ]; then
            echo "Archive storage is not mounted yet; waiting up to ${_mount_wait}s (set MP_ARCHIVE_MOUNT_WAIT=0 to skip)..."
            for (( _i=0; _i<_mount_wait; _i++ )); do
                [ -d "$_ARCHIVE_DIR" ] && break
                sleep 1
            done
        fi
    fi
fi

TARGET_DIR="$_ARCHIVE_DIR"
if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
    TARGET_DIR="$CODEBASE_DIR"
    if [ -n "$_ARCHIVE_DIR" ]; then
        echo "Notice: archive storage '${_ARCHIVE_DIR}' is not mounted; starting in '${CODEBASE_DIR}'."
    fi
fi

if [ -f "$SCRIPT" ]; then
    printf '\033]0;%s\007' "MP Mix Archive Manager" 2>/dev/null || true
    # If the archive disappeared between the check and here, stay in the
    # application tree instead of exiting with no manager at all.
    cd "$TARGET_DIR" 2>/dev/null || cd "$CODEBASE_DIR" 2>/dev/null || true
    exec bash "$SCRIPT" "$@"
else
    echo "Error: MP Mix Archive Manager main script not found at '$SCRIPT'."
    read -rp "Press Enter to exit..."
    exit 1
fi
