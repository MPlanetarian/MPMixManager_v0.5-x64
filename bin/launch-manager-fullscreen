#!/usr/bin/env bash
# ==============================================================================
# Helper: launch-manager-fullscreen
# Purpose: Launch MP Mix Archive Manager in a full-screen dedicated Konsole window
# ==============================================================================
# Resolve symlinks so CODEBASE_DIR is accurate regardless of invocation path (e.g. ~/.local/bin)
_RESOLVED_SRC="${BASH_SOURCE[0]}"
while [ -h "$_RESOLVED_SRC" ]; do
    _RESOLVED_DIR="$(cd -P "$(dirname "$_RESOLVED_SRC")" >/dev/null 2>&1 && pwd)"
    _RESOLVED_SRC="$(readlink "$_RESOLVED_SRC")"
    [[ $_RESOLVED_SRC != /* ]] && _RESOLVED_SRC="$_RESOLVED_DIR/$_RESOLVED_SRC"
done
_BIN_DIR="$(cd -P "$(dirname "$_RESOLVED_SRC")" >/dev/null 2>&1 && pwd)"
CODEBASE_DIR="$(cd -P "$_BIN_DIR/.." >/dev/null 2>&1 && pwd)"

# Fallback candidate search if not found. Resolve by marker file rather than a
# hard-coded user name or version-numbered directory.
if [ ! -f "$CODEBASE_DIR/Mix_Archive_Manager.sh" ]; then
    _lib="$CODEBASE_DIR/scripts/lib/mp_install_dir.sh"
    [ ! -f "$_lib" ] && _lib="$HOME/.config/mix-manager/lib/mp_install_dir.sh"
    [ -f "$_lib" ] && . "$_lib"
    _found=""
    if command -v mp_find_install_dir >/dev/null 2>&1; then
        _found="$(mp_find_install_dir 2>/dev/null || true)"
    fi
    if [ -z "$_found" ]; then
        for _c in $(ls -d "$HOME"/MP*ix*anager* 2>/dev/null | sort -rV); do
            if [ -f "$_c/Mix_Archive_Manager.sh" ]; then
                _found="$_c"
                break
            fi
        done
    fi
    [ -n "$_found" ] && CODEBASE_DIR="$_found"
fi
unset _RESOLVED_SRC _RESOLVED_DIR _BIN_DIR _c _found _lib
LAUNCHER="$CODEBASE_DIR/bin/mix-archive-manager"

if [ ! -x "$LAUNCHER" ]; then
    LAUNCHER="$CODEBASE_DIR/Mix_Archive_Manager.sh"
fi

# Monospace, at the point size of the user's default Konsole profile.
if [ -f "$CODEBASE_DIR/scripts/mp_cli_font.sh" ]; then
    # shellcheck disable=SC1091
    . "$CODEBASE_DIR/scripts/mp_cli_font.sh"
    mp_ensure_cli_font_profile
fi

exec /usr/bin/konsole --fullscreen --separate --profile MP_Mix_Manager --workdir "$CODEBASE_DIR" -p tabtitle="MP Mix Archive Manager" -e "$LAUNCHER" "$@"
