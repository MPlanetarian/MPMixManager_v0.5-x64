<?xml version="1.0" encoding="utf-8"?>
<!--
  MP Mix Manager - Windows installer (x64 / x86).

  This reproduces the 0.5.4 MSI that was built with WiX 5.0.2 on the Windows 11
  test bed. The properties, upgrade rules and launch conditions below were read
  straight out of that package, so an upgrade from the shipped 0.5.4 behaves
  exactly as it did:

    * same UpgradeCode, so an existing install is replaced rather than doubled
    * same per-machine context (ALLUSERS=1)
    * refuse a downgrade, and refuse to run below Windows 10
    * Start Menu shortcut "MP Mix Manager" -> manager.bat

  The file payload is generated by scripts/gen_wix_payload.py into
  Payload.wxs and pulled in through PayloadGroup.

  Build with:
      wix build Product.wxs Payload.wxs -arch x64 -o out.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="MP Mix Manager"
      Manufacturer="MPlanetarian"
      Version="0.5.4.0"
      UpgradeCode="A9F4241B-E7E6-4E37-BB44-A37E67599C8E"
      Scope="perMachine"
      Compressed="yes"
      Language="0">

    <SummaryInformation
        Description="MP Mix Manager"
        Manufacturer="MPlanetarian" />

    <MajorUpgrade
        AllowDowngrades="no"
        AllowSameVersionUpgrades="no"
        DowngradeErrorMessage="A newer version of MP Mix Manager is already installed."
        Schedule="afterInstallValidate" />

    <!--
      Windows 10 and 11 only.

      The shipped 0.5.4 package tested ``VersionNT >= 1000``. That is wrong on
      the very systems it is meant to allow: Microsoft's Windows Installer sets
      VersionNT to 603 on Windows 10 (and Windows Server 2016/2019) by design,
      so the check refused every Windows 10 install with error 1603. Only a
      package that resets the property itself ever reports 1000.

      CurrentBuildNumber is authoritative: Windows 10 RTM is 10240, 22H2 is
      19045, and Windows 11 starts at 22000. The VersionNT test is kept as an
      alternative so a future engine that does report 1000 still passes.
    -->
    <Property Id="WINDOWS_BUILD">
      <RegistrySearch
          Id="WindowsBuildSearch"
          Root="HKLM"
          Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
          Name="CurrentBuildNumber"
          Type="raw" />
    </Property>

    <Launch
        Condition="MsiNTProductType = 1 AND ((VersionNT &gt;= 1000) OR (WINDOWS_BUILD &gt;= 10240))"
        Message="MP Mix Manager supports Windows 10 and Windows 11 only." />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="MP Mix Manager" Level="1" Display="expand">
      <ComponentGroupRef Id="PayloadGroup" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="MP Mix Manager" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MP Mix Manager" />
    </StandardDirectory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="4B7C1E52-8A3D-4C6F-9D21-7E5B0A9C3F18">
        <Shortcut
            Id="ManagerShortcut"
            Name="MP Mix Manager"
            Description="Launch MP Mix Manager"
            Target="[INSTALLFOLDER]manager.bat"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\MPlanetarian\MP Mix Manager"
            Name="StartMenu"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

  </Package>
</Wix>
