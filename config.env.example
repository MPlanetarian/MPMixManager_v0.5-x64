# ==============================================================================
# MP_Mix_Manager_v0.5 - Environment & Configuration File
# Copy this file to 'config.env' to customize paths and settings.
# ==============================================================================

# Root directory of your music and mix archive.
# Auto-detected defaults across platforms:
#   Linux:   /run/media/$USER/WD BLACK B/MIX_ARCHIVE
#   macOS:   /Volumes/WD BLACK B/MIX_ARCHIVE or /Volumes/MIX_ARCHIVE
#   Windows: D:/MIX_ARCHIVE or /d/MIX_ARCHIVE
# If not configured (MIX_ARCHIVE_CONFIGURED="false"), the application defaults
# to using the root application folder MIX_ARCHIVE ($SCRIPT_DIR/MIX_ARCHIVE).
# Set to "true" once configured via Option 13 or set manually:
MIX_ARCHIVE_CONFIGURED="false"
MIX_ARCHIVE_DIR=""
# MIX_ARCHIVE_DIR="/run/media/$USER/WD BLACK B/MIX_ARCHIVE"
# MIX_ARCHIVE_DIR="/Volumes/WD BLACK B/MIX_ARCHIVE"
# MIX_ARCHIVE_DIR="D:/MIX_ARCHIVE"

# Additional / Multiple Mix Archive Storage Locations (separated by semicolon, comma, or newline)
# Semicolon (;) is recommended on Windows to preserve drive letters (e.g. G:\My Drive\MIX_ARCHIVE;D:\Mixes)
# (e.g. Linux: EXTRA_MIX_ARCHIVE_DIRS="/run/media/$USER/DATA/MIX_ARCHIVE2/FLAC_CONVERTED_OUTPUTS")
# (e.g. Windows: EXTRA_MIX_ARCHIVE_DIRS="G:\My Drive\MIX_ARCHIVE;D:\Mixes\FLAC_CONVERTED_OUTPUTS")
EXTRA_MIX_ARCHIVE_DIRS=""

# --- macOS: archives that live on a Linux workstation ------------------------
# A Mac has no local MIX_ARCHIVE, so mount the Linux shares at stable paths and
# point the three settings above at them. One helper does both:
#
#   bash scripts/mount_mix_archives.sh --install   # mount + login agent
#   bash scripts/mount_mix_archives.sh --status    # share, host, mix count
#
# It mounts each share under ~/MIX_ARCHIVE_MOUNTS and a LaunchAgent remounts a
# dropped share every 5 minutes. Configure it here (a password set below wins;
# otherwise the login keychain is asked, so no password sits in this file):
# MIX_ARCHIVE_SMB_USER="mplanetarian"
# MIX_ARCHIVE_SMB_PASSWORD=""
# MIX_ARCHIVE_SMB_SHARES="192.0.2.10/WD%20BLACK|wd_black_archive;192.0.2.10/512GB_BKP_004|archive_512"
#
# The matching archive settings then read:
# MIX_ARCHIVE_DIR="$HOME/MIX_ARCHIVE_MOUNTS/wd_black_archive/MIX_ARCHIVE"
# EXTRA_MIX_ARCHIVE_DIRS="$HOME/MIX_ARCHIVE_MOUNTS/archive_512/MIX_ARCHIVE;$HOME/MIX_ARCHIVE_MOUNTS/mix_archive_1tb/MIX_ARCHIVE"

# Output directory for converted FLAC files (relative to MIX_ARCHIVE_DIR or absolute)
OUTPUT_DIR="FLAC_CONVERTED_OUTPUTS"

# Archive directory for converted WAV source files
ARCHIVE_DIR="CONVERTED_WAV_FILES"

# Spek spectrogram output directory
SPEK_DIR="SPEK_OUTPUTS"

# Traktor Pro History XML directory for automatic tracklist extraction
# Auto-detected across platforms:
#   Linux:   /run/media/$USER/WD BLACK B/MIX_ARCHIVE/Traktor 3.11.1/History
#   macOS:   /Volumes/WD BLACK B/MIX_ARCHIVE/Traktor 3.11.1/History or $HOME/Documents/Native Instruments/Traktor 3.11.1/History
#   Windows: D:/MIX_ARCHIVE/Traktor 3.11.1/History or C:/Users/$USER/Documents/Native Instruments/Traktor 3.11.1/History
# TRAKTOR_HISTORY_DIR="/run/media/$USER/WD BLACK B/MIX_ARCHIVE/Traktor 3.11.1/History"

# Cloud & Remote Backup Destinations (Google Drive, iCloud, Dropbox, Custom Folder)
# Google Drive remote name and path configured in rclone
GDRIVE_REMOTE="gdrive:MIX_ARCHIVE/FLAC_CONVERTED_OUTPUTS"

# Apple iCloud destination folder (macOS native iCloud Drive or local folder)
# Default on macOS: "$HOME/Library/Mobile Documents/com~apple~CloudDocs/MIX_ARCHIVE"
ICLOUD_PATH="${HOME}/Library/Mobile Documents/com~apple~CloudDocs/MIX_ARCHIVE"

# Dropbox destination folder (Local Dropbox sync folder or rclone remote)
# Default: "$HOME/Dropbox/MIX_ARCHIVE" or "dropbox:MIX_ARCHIVE"
DROPBOX_PATH="${HOME}/Dropbox/MIX_ARCHIVE"

# Custom cloud or local backup destination (optional fallback)
# CLOUD_BACKUP_DEST="/run/media/$USER/BACKUP_DRIVE/MIX_ARCHIVE"

# NFT Videos directory for playlist generation
# NFT_VIDEOS_DIR="/run/media/$USER/DATA/NFT_VIDEOS"

# WAN2GP AI Video & Image Generator directories (required before accessing WAN2GP options)
# Set to "true" once configured:
WAN2GP_CONFIGURED="false"
# WAN2GP_DIR: Root of Wan2GP repo / application
#   Windows: "X:/WAN2GP/Wan2GP" or "D:/WAN2GP/Wan2GP"
#   Linux:   "$HOME/pinokio/api/wan.git/app" or "/var/home/$USER/pinokio/api/wan.git/app"
# WAN2GP_DIR="X:/WAN2GP/Wan2GP"
# WAN2GP_PYTHON: Python interpreter with PyTorch / CUDA installed
#   Windows: "X:/WAN2GP/conda_envs/wan2gp/python.exe"
#   Linux:   "$HOME/pinokio/api/wan.git/app/venv/bin/python"
# WAN2GP_PYTHON="X:/WAN2GP/conda_envs/wan2gp/python.exe"
# WAN2GP_OUTPUTS: Main output folder for generated videos, images, and audio
#   Windows: "D:/DATA_DRIVE_MOVED/WAN2GP_OUTPUTS"
#   Linux:   "/run/media/$USER/GAMES1/DATA_DRIVE_MOVED/WAN2GP_OUTPUTS"
# WAN2GP_OUTPUTS="D:/DATA_DRIVE_MOVED/WAN2GP_OUTPUTS"
# WAN2GP_FLUX_BATCH_DIR: Batch workspace for Flux 2 Klein 9B (contains CTRL_IMAGE, PROCESSED)
#   Windows: "D:/DATA_DRIVE_MOVED/WAN2GP_FLUX_BATCH"
#   Linux:   "/run/media/$USER/GAMES1/DATA_DRIVE_MOVED/WAN2GP_FLUX_BATCH"
# WAN2GP_FLUX_BATCH_DIR="D:/DATA_DRIVE_MOVED/WAN2GP_FLUX_BATCH"
# WAN2GP_LTX_BATCH_DIR: Batch workspace for LTX Video 2B/13B/22B (contains CTRL_VIDEO, PROCESSED)
#   Windows: "D:/DATA_DRIVE_MOVED/WAN2GP_LTX_BATCH"
#   Linux:   "/run/media/$USER/GAMES1/DATA_DRIVE_MOVED/WAN2GP_LTX_BATCH"
# WAN2GP_LTX_BATCH_DIR="D:/DATA_DRIVE_MOVED/WAN2GP_LTX_BATCH"
# WAN2GP_LTX_LORA: Default LoRA enhancement for LTX Video generation (bfs_head_swap, editanything_v2, deblur, etc.)
# WAN2GP_LTX_LORA="bfs_head_swap"

# Default Audio Player for playback and startup auto-play
# Options: mp_liquid_glass (default), mp_audio_player, strawberry, cliamp, vlc, haruna, kodi, mpv, audacity
DEFAULT_AUDIO_PLAYER="mp_liquid_glass"

# Standalone Liquid Glass Audio Player Backend: opengl or vulkan (default: opengl)
# opengl: High compatibility across AMD Radeon, Intel, NVIDIA, and older GPUs
# vulkan: NVIDIA Vulkan hardware pipeline
# Both backends draw the MP Visualizer inside the player window and run the
# standalone MP Visualizer with every preset.
# The installer replaces this placeholder with the backend it detected for this
# machine: VULKAN when an NVIDIA GPU advertises Vulkan, OPENGL otherwise.
LIQUID_GLASS_BACKEND="opengl"

# MP Visualizer Backend: auto, opengl, or vulkan (default: auto)
# auto follows LIQUID_GLASS_BACKEND above, then prefers Vulkan when an NVIDIA
# GPU advertises a working Vulkan device, and falls back to OpenGL when it
# does not. The installer writes the answer for this machine here.
# Set this only to force the standalone visualizer onto a specific backend.
#VISUALIZER_BACKEND="auto"

# Raspberry Pi / low-power GPU tuning (optional; chosen automatically)
# A Pi 4/5 GPU reports OpenGL 3.1 / GLSL 1.40, not desktop 3.3. The renderer
# detects this and compiles a down-levelled shader, so it starts without any
# setting here. These three values only choose how much work the visualizer
# does once it is running, and are read before the first Python import.
# The defaults picked for each board:
#   Pi 5 8 GB  1280 px, 64 steps    Pi 5 4 GB  960 px, 56 steps
#   Pi 4        640 px, 44 steps    Pi 3/Zero 2 480 px, 32 steps
# Raise them for a sharper picture, lower them if the visualizer stutters.
#MP_VISUALIZER_GL_LONG_EDGE=640
#MP_VISUALIZER_GL_MARCH_STEPS=44
# Start on a cheap single-scene preset instead of the twelve-scene blend.
#MP_VISUALIZER_SAFE_PRESET=1
# The Bluetooth router forks pactl several times a second. It is disabled
# automatically when the kernel exposes no Bluetooth adapter.
#MP_DISABLE_BLUETOOTH_MONITOR=1

# Startup Autoplay Settings
# Set to "true" to automatically play a mix when the manager starts up
AUTO_PLAY_ON_STARTUP="true"

# Automatically open and display cover art on startup
AUTO_SHOW_COVER_ON_STARTUP="false"

# The Manager does not open a tracklist window on startup or when playback starts.
# Open a tracklist from the Tracklist menu, or press T in MP Audio Player.
AUTO_SHOW_TRACKLIST_ON_STARTUP="false"

# Default Tracklist Viewer (opens tracklist in a dedicated new window on boot)
# Options: console (default: OS default console / borderless terminal on Bazzite Linux), auto (external GUI editor), kwrite, kate, gedit, mousepad, konsole, xdg-open
TRACKLIST_VIEWER="console"

# Startup Mix Selection Mode: "latest" (newest mix), "random", or specific mix filename/keyword
AUTO_PLAY_MIX_SELECTION="latest"

# Startup Loader Video Settings
# Set to "true" to display the startup loader video (MP_loader.mp4) while the manager loads in the console.
# Automatically skipped if another instance of the manager is already open.
SHOW_LOADER_VIDEO="true"
LOADER_VIDEO_FILE="MP_loader.mp4"

# Exit Video Settings
# Set to "true" to play Exit_MP_Video.mp4 when the last MP Gui or MP Liquid
# Player window closes. It is shown once, for the last window of either kind,
# and is skipped while any other MP Gui or MP Liquid Player window is open.
# The same switch covers the uninstaller: while ./uninstall.sh is working, the
# movie loops in its own window and the window closes when the uninstaller exits.
SHOW_EXIT_VIDEO="true"
EXIT_VIDEO_FILE="Exit_MP_Video.mp4"
# Upper bound in seconds before a stuck player is stopped.
EXIT_VIDEO_MAX_SECONDS="90"

# MP Gui and MP Liquid Player First-Launch Intro
# The first MP Gui window and the first MP Liquid Player window of each
# session each play Exit_MP_Video.mp4 once, before their glass appears. The
# movie window closes when the clip ends. A second, third, or fourth window
# of that same kind never shows it. Closing every window of that kind and
# opening one again plays it once more. The tracklist viewer, VR Mode, and
# benchmark and soak runs never show it.
SHOW_PLAYER_INTRO_VIDEO="true"
# Upper bound in seconds before a stuck intro player is stopped.
PLAYER_INTRO_VIDEO_MAX_SECONDS="90"

# ==============================================================================
# Promotional & Publisher Outreach Email Settings
# ==============================================================================
# Senders information
PROMO_SENDER_NAME="MPlanetarian"
# PROMO_SENDER_EMAIL="artist@example.com"
# PROMO_REPLY_TO="artist@example.com"

# Outgoing SMTP Server (e.g., Gmail, Outlook, AWS SES, or Custom Mailserver)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="artist@example.com"
# SMTP_PASSWORD="" # Optional app password (can also be entered interactively)
# SMTP_USE_TLS="true"
# SMTP_USE_SSL="false"

# Default Promo & Streaming URLs
# PROMO_PODCAST_URL="https://podcasts.apple.com/..."
# PROMO_SOUNDCLOUD_URL="https://soundcloud.com/mplanetarian"
# PROMO_YOUTUBE_URL="https://youtube.com/@mplanetarian"
# PROMO_MIXCLOUD_URL="https://mixcloud.com/mplanetarian"
# PROMO_WEBSITE_URL="https://mplanetarian.com"

# ==============================================================================
# Universal Search & Import Mixes Settings (Local Drives & SMB)
# ==============================================================================
# Minimum file size in MB to qualify as a full mix (default: 100)
# SEARCH_IMPORT_MIN_SIZE_MB="100"

# Preferred default SMB host / share for mix ingest
# SMB_DEFAULT_HOST="192.0.2.20"

# ==============================================================================
# Option 1 — Music Folders (local drives and SMB shares only)
# ==============================================================================
# Music folders are not hard-coded. Add and remove them from Option 1, or with:
#   python3 scripts/music_folders_manager.py --add "\\\\host\\share"
#   python3 scripts/music_folders_manager.py --add "D:\\Music"
#   python3 scripts/music_folders_manager.py --remove MUSIC001
# The list for this machine is stored in ~/.config/mix-manager/music_folders.json
#
# Optional SMB credentials. The password is not written into the folder list.
# MUSIC_SMB_USER=""
# MUSIC_SMB_PASSWORD=""
# Linux/macOS rclone mount root. Windows opens the UNC path directly.
# MUSIC_SMB_MOUNT_ROOT="$HOME/MUSIC_SMB"
# Used once, only when music_folders.json does not exist yet:
# MUSIC_SMB_HOST=""
# MUSIC_SMB_SHARES=""

# Automatically prompt or run FLAC conversion after importing new WAV mixes
# AUTO_CONVERT_AFTER_IMPORT="true"

# ==============================================================================
# Video Player & Startup Custom YouTube Video Settings
# ==============================================================================
# Default Video Player for mix companion videos and visual playback
# Options: vlc, mpv, haruna, kodi
DEFAULT_VIDEO_PLAYER="vlc"

# Custom YouTube video URL to play on manager startup (e.g. ambient visualizer)
# Plays only if a mix is playing already in a music player
AUTO_PLAY_YOUTUBE_ON_STARTUP="false"
STARTUP_YOUTUBE_URL=""

# ==============================================================================
# Meteorological & Planetary Ephemeris Settings
# ==============================================================================
# Display current weather below the startup banner
WEATHER_ENABLED="true"

# Weather location (e.g., Swansea, UK or London, UK)
WEATHER_LOCATION="Swansea, UK"

# Display planets currently above the horizon for your location below the weather
PLANETS_ENABLED="true"

# ==============================================================================
# Traktor Database & Remote Top 5 Tracks Settings
# ==============================================================================
# Path to Traktor Pro 3/4 collection.nml or History directory
TRAKTOR_COLLECTION_PATH="/run/media/mplanetarian/WD BLACK B/MIX_ARCHIVE/Traktor 3.11.1/collection.nml"

# Root directory where audio files referenced in Traktor collection reside
TRAKTOR_AUDIO_ROOT="/run/media/mplanetarian/WD BLACK B/MIX_ARCHIVE"

# Traktor Audio Source Mode: local, smb, nfs, remote_mac
TRAKTOR_REMOTE_TYPE="local"

# Traktor SMB Tracklist Host / Share / User / Password
# Required by Make_SOF_FLAC_CONVERSION.sh to sync remote Traktor history files.
# Leave any value empty to skip the remote sync and use local history only.
# TRAKTOR_SMB_HOST="192.0.2.20"
# TRAKTOR_SMB_SHARE="mplanetarian"
# TRAKTOR_SMB_USER=""
# TRAKTOR_SMB_PASSWORD=""

# Path to the History folder inside TRAKTOR_SMB_SHARE (relative to share root)
# TRAKTOR_SMB_HISTORY_DIR="Documents/Native Instruments/Traktor 3.11.1/History"

# Network SMB Share mount point (e.g. /run/user/1000/gvfs/... or /mnt/mac_smb)
TRAKTOR_SMB_MOUNT=""

# Network NFS Share mount point (e.g. /mnt/mac_nfs)
TRAKTOR_NFS_MOUNT=""

# ==============================================================================
# MP Audio Player Favorites DJ Set Exporter
# ==============================================================================
# Default local folder for [J] in the Favorites playlist
# FAV_EXPORT_LOCAL_DIR="$HOME/Music/MP_Fav_Playlists"

# SMB destination for the exporter. Any value left empty falls back to the
# TRAKTOR_SMB_* / MUSIC_SMB_* settings above.
# FAV_EXPORT_SMB_HOST="192.0.2.20"
# FAV_EXPORT_SMB_SHARE="mplanetarian"
# FAV_EXPORT_SMB_USER=""
# FAV_EXPORT_SMB_PASSWORD=""
# Folder inside the share, e.g. Music/MP_Fav_Playlists
# FAV_EXPORT_SMB_PATH=""

# Optional already-mounted SMB path. When set and present, files are copied
# straight into that mount instead of through smbclient.
# FAV_EXPORT_SMB_MOUNT=""

# Set to false to stop offering the Traktor playlist step after an export
# TRAKTOR_ENABLED="true"

# Remote Mac Workstation SSH Details (for automated rsync/scp audio retrieval)
TRAKTOR_MAC_HOST=""
TRAKTOR_MAC_USER=""

# ==============================================================================
# Automated Mix Reports & Operational Telemetry Settings
# ==============================================================================
# Enable or disable automated daily mix reports (true/false)
DAILY_REPORTS_ENABLED="true"

# Scheduled daily update time in 24-hour HH:MM format (e.g. 10:00)
DAILY_REPORTS_TIME="10:00"

# Enable or disable monthly and yearly mix reports (true/false)
MONTHLY_REPORTS_ENABLED="true"
YEARLY_REPORTS_ENABLED="true"

# Last report generation markers (managed automatically by reporter)
LAST_DAILY_REPORT_RUN=""
LAST_MONTHLY_REPORT_RUN=""
LAST_YEARLY_REPORT_RUN=""

# ------------------------------------------------------------------------------
# OpenCode Agent Progress Briefings (MP Reporter)
# ------------------------------------------------------------------------------
# Emails a TEXT report plus a Stephen Hawking voice AUDIO report covering every
# running OpenCode agent session. Installed as the user timer
# mp-reporter-opencode-progress.timer by:
#   scripts/mp_opencode_progress_reporter.sh enable [MINUTES]
OPENCODE_PROGRESS_ENABLED="true"

# Minutes between briefings (10 = 144 briefings a day).
OPENCODE_PROGRESS_INTERVAL_MINUTES="10"

# Recipients for the progress briefings. Empty reuses EMAIL_RECIPIENTS from
# email_config.env.
OPENCODE_PROGRESS_RECIPIENTS=""

# Subject prefix shown in the mailbox, followed by date, time and session count.
OPENCODE_PROGRESS_SUBJECT_PREFIX="OpenCode Agent Progress"

# Attach the generated reports. The email body always carries the text.
OPENCODE_PROGRESS_ATTACH_TEXT="true"
OPENCODE_PROGRESS_ATTACH_AUDIO="true"

# Synthesize the Stephen Hawking Matrix voice audio briefing.
OPENCODE_PROGRESS_TTS_ENABLED="true"

# Send even when no agent session is running. Set false to stay silent when
# OpenCode is idle.
OPENCODE_PROGRESS_SEND_WHEN_IDLE="true"

# Play the confirmation alert sound on the workstation after each dispatch.
OPENCODE_PROGRESS_ALERT_SOUND="true"

# Caps that keep one briefing readable. Sessions beyond MAX_SESSIONS are
# counted in the report but not listed; the audio names the same sessions as
# the text report.
OPENCODE_PROGRESS_MAX_SESSIONS="12"
OPENCODE_PROGRESS_MAX_MESSAGES="12"

# ==============================================================================
# Studio & DJ Booth Mobile Web Companion Settings
# ==============================================================================
# Enable or disable the Web Companion server
WEB_COMPANION_ENABLED="true"

# Bind address (0.0.0.0 binds to all LAN interfaces, or specify 192.0.2.11)
WEB_COMPANION_HOST="0.0.0.0"

# Server listening port
WEB_COMPANION_PORT="8888"

# Start or resume playback automatically when the Web Companion service starts.
# The companion itself never plays audio locally - phones and tablets listen to
# the HTTP audio stream (/api/stream). An MP Audio Player daemon is started (or
# reused) so the stream has a live position to serve.
# Set to "false" to leave playback untouched on service start.
WEB_COMPANION_AUTOPLAY="true"

# What to play when the companion starts:
#   MIX_ARCHIVE (default) - newest audio across the configured mix archive folders
#   MUSIC                 - the saved DJ_Tracks_ALL_MUSIC_FOLDERS playlist
WEB_COMPANION_MODE="MIX_ARCHIVE"

# Optional explicit playlist file (.m3u, .m3u8, or .json). When set it takes
# priority over WEB_COMPANION_MODE. An empty or missing file means nothing is
# played at all - the companion never starts a player for an empty playlist.
# WEB_COMPANION_PLAYLIST="/home/user/MIX_ARCHIVE/Back to Trance Roots.m3u"

# ------------------------------------------------------------------------------
# MP Assistant tab (MP Harmony Agent bridge)
# ------------------------------------------------------------------------------
# The companion page has two tabs: MP Liquid Player and MP Assistant. The
# assistant tab talks to the MP Harmony Agent through the companion, because the
# agent listens on 127.0.0.1:11435 and a phone on the LAN cannot reach that.
# The agent must already be running (Manager > 33 > 4, or manage_harmony_agent.sh).
MP_ASSISTANT_ENABLED="true"

# Where the MP Harmony Agent listens. Change only if it was moved off its default.
MP_ASSISTANT_URL="http://127.0.0.1:11435"

# How long a single assistant reply may stream before the proxy gives up (seconds).
MP_ASSISTANT_TIMEOUT="600"

# ==============================================================================
# Hardware MIDI Controller Settings (Traktor Kontrol S4 Exclusive - v0.4.3)
# ==============================================================================
# Enable or disable Traktor Kontrol S4 Hardware MIDI control (true / false)
MIDI_CONTROL_ENABLED="true"

# ALSA Hardware MIDI port for Traktor Kontrol S4
MIDI_DEVICE_PORT="hw:0,0"
MIDI_DEVICE_NAME="Traktor Kontrol S4"

# Set to true once the user has been notified of first-time detection
TRAKTOR_S4_NOTIFIED="false"


# ==============================================================================
# Manager Menu Mouse Support
# ==============================================================================
# Enable mouse clicks and wheel scrolling inside the Manager menus.
# A single click moves the highlight; a double click activates the option.
# Set to "false" to keep the terminal's native text selection instead.
MP_MANAGER_MOUSE="true"

# ==============================================================================
# Game Controllers (Xbox, PlayStation, Nintendo & Steam)
# ==============================================================================
# Linux only. A connected pad drives the Manager menus: the D-pad or left stick
# moves, A / Cross / Nintendo A selects, B / Circle / Nintendo B goes back,
# X / Square / Nintendo Y plays or pauses, LB and RB page up and down, and LT
# and RT (ZL and ZR on a Switch pad) step to the previous and next track.
# Set to "false" to ignore controllers in the Manager menus.
MP_MANAGER_GAMEPAD="true"

# ==============================================================================
# Multi-Screen Console Layout
# ==============================================================================
# The console menu can use one, two or three displays side by side. The main
# menu is cut at its SECTION markers:
#   single  one column, exactly as before
#   dual    SECTION 1 on the left display, every later section on the right
#   triple  SECTION 1 left, SECTION 2 middle, SECTION 3 right
#   auto    follow the connected displays (the default)
#
# Dual and triple need the displays used for the layout to share one width --
# 3 x 1920, 2 x 2560, 3 x 4K and so on -- and the console window has to span
# them. A wider display (a 4K TV beside three 1920 monitors) is left alone: the
# largest matching group is used. Force a layout here when the window manager
# will not report the window size.
# Change it from the menu: Option 31 -> Multi-Screen Console Layout.
MP_SCREEN_LAYOUT="auto"

# Stretch the manager console window across every matching display on launch.
# Best effort: KWin scripting on Wayland, wmctrl or xdotool on X11. Set to
# "false" to manage the window yourself.
MP_SCREEN_ALIGN_TERMINAL="true"

# Maximum banner rows kept in the shared header when a three-column layout
# would otherwise not fit on a short terminal. Default 6.
# MP_SCREEN_HEADER_LINES="6"

# Read the console window's pixel size so the layout can tell whether the
# window really spans the displays. auto (default), on, or off.
# MP_SCREEN_PIXEL_PROBE="auto"

# ==============================================================================
# MP HARMONY SPEECH  (shared by MP Reporter and the MP Audio Responder)
# ==============================================================================
# The MP Harmony Agent exposes an OpenAI-compatible speech endpoint with the
# Matrix voice set. One voice setting drives both programs; change it from the
# menu (MP Reporter Suite -> MP Audio Responder -> Choose Harmony Voice) or with:
#   scripts/mp_harmony_tts.py --set-voice morpheus
# HARMONY_VOICE=morpheus

# Speech backend for the Audio Responder's narration:
#   harmony        MP Harmony only
#   harmony-first  MP Harmony, then WAN2GP, then the Hawking chain  [recommended]
#   wan2gp         WAN2GP, then the Hawking chain                   [default]
#   espeak         the Hawking chain only
# MP_OPENCODE_TTS_ENGINE="wan2gp"

# Voice id used by the responder (defaults to the shared HARMONY_VOICE setting).
# MP_OPENCODE_TTS_VOICE=""
