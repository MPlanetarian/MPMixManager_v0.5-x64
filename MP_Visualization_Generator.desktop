[Desktop Entry]
Type=Application
Name=MP Visualisation Generator
GenericName=MP Visualizer Preset Generator
Comment=Build 3D audio-reactive MP Visualizer presets from artwork
# The install tree is resolved at launch, so no user name or versioned path is
# stored here. mp-desktop-exec lives in ~/.local/bin and follows the install.
Exec=sh -c "exec \"\$HOME/.local/bin/mp-desktop-exec\" MP_Visualization_Generator.sh"
Icon=mp_liquid_glass_icon
Terminal=false
Categories=AudioVideo;Audio;Graphics;
StartupNotify=true
StartupWMClass=MP_Visualisation_Generator
X-KDE-GlobalAccel-CommandShortcut=true
